@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="2" Dense="true" Color="Color.Surface">
        <MudText Typo="Typo.h6">GeniusWeb</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                       Href="/settings" title="Settings" />
        <MudIconButton Icon="@Icons.Material.Filled.DesktopWindows" Color="Color.Inherit"
                       Href="/console" title="PC console" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="/logout" />
    </MudAppBar>

    <MudMainContent Class="pb-20">
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2">
            @Body
        </MudContainer>
    </MudMainContent>

    <BottomNav />
</MudLayout>

@code {
    private MudTheme Theme { get; } = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#4ea8de",
            Secondary = "#52b788",
            Surface = "#1f1f1f",
            Background = "#121212",
            AppbarBackground = "#1f1f1f",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Inter", "system-ui", "sans-serif"],
            },
        },
    };
}
