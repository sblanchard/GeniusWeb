@page "/rotator"
@attribute [Authorize]
@using GeniusWeb.Web.Services
@inject GeniusWeb.Web.Services.DeviceLiveStore Store
@implements IDisposable

<PageTitle>Rotator</PageTitle>

@if (Device is null)
{
    <div class="dev-empty">No rotator configured.</div>
}
else
{
    <div class="rg-shell">
        <div class="rg-header">
            @if (Rotators.Count == 0)
            {
                <span class="rg-tab">Rotator <strong>---°</strong></span>
            }
            @foreach (var rotator in Rotators)
            {
                var index = rotator.Index;
                <button class="rg-tab @(index == Selected ? "rg-tab-on" : "")" @onclick="() => Select(index)">
                    @rotator.Name <strong>@Heading(rotator.Azimuth)°</strong>
                </button>
            }
        </div>

        <div class="rg-canvas">
            <svg viewBox="-110 -110 220 220" preserveAspectRatio="xMidYMid meet"
                 @onclick="OnDialClick">
                <circle r="100" fill="#0a3a5e" stroke="#5a8fb5" stroke-width="2" />
                <circle r="80"  fill="#1c5b8a" />
                <circle r="60"  fill="none" stroke="#3a6f95" stroke-width="0.5" />
                <circle r="40"  fill="none" stroke="#3a6f95" stroke-width="0.5" />
                <circle r="20"  fill="none" stroke="#3a6f95" stroke-width="0.5" />

                @* Minor ticks every 10°, short and only on the outer rim — no overlap with labels *@
                @foreach (var deg in Enumerable.Range(0, 36).Select(i => i * 10))
                {
                    if (deg % 30 == 0) continue; // skip positions where labels live
                    var rad = (deg - 90) * Math.PI / 180.0;
                    var inner = (Math.Cos(rad) * 96).ToString("F1");
                    var innerY = (Math.Sin(rad) * 96).ToString("F1");
                    var outer = (Math.Cos(rad) * 100).ToString("F1");
                    var outerY = (Math.Sin(rad) * 100).ToString("F1");
                    <line x1="@inner" y1="@innerY" x2="@outer" y2="@outerY" stroke="#52b788" stroke-width="0.6" opacity="0.5" />
                }

                @* Major degree labels at every 30° *@
                @foreach (var deg in Enumerable.Range(0, 12).Select(i => i * 30))
                {
                    var rad = (deg - 90) * Math.PI / 180.0;
                    var labelX = (Math.Cos(rad) * 92).ToString("F1");
                    var labelY = (Math.Sin(rad) * 92 + 3).ToString("F1");
                    @((MarkupString)$"<text x='{labelX}' y='{labelY}' fill='#cfe1f0' font-size='8' text-anchor='middle'>{deg}</text>")
                }

                @* Cardinal labels (N/S/E/W) at the ring *@
                @foreach (var (lab, deg) in new[] { ("N", 0), ("E", 90), ("S", 180), ("W", 270) })
                {
                    var rad = (deg - 90) * Math.PI / 180.0;
                    var lx = (Math.Cos(rad) * 70).ToString("F1");
                    var ly = (Math.Sin(rad) * 70 + 4).ToString("F1");
                    @((MarkupString)$"<text x='{lx}' y='{ly}' fill='#fff' font-size='10' font-weight='700' text-anchor='middle'>{lab}</text>")
                }

                @* Needle *@
                @{
                    var aRad = (Azimuth - 90) * Math.PI / 180.0;
                    var ax = (Math.Cos(aRad) * 78).ToString("F1");
                    var ay = (Math.Sin(aRad) * 78).ToString("F1");
                }
                <line x1="0" y1="0" x2="@ax" y2="@ay" stroke="#e23a3a" stroke-width="3" stroke-linecap="round" />
                <circle cx="0" cy="0" r="4" fill="#e23a3a" />

                @if (TargetAz.HasValue)
                {
                    var tRad = (TargetAz.Value - 90) * Math.PI / 180.0;
                    var tx = (Math.Cos(tRad) * 92).ToString("F1");
                    var ty = (Math.Sin(tRad) * 92).ToString("F1");
                    <circle cx="@tx" cy="@ty" r="5" fill="none" stroke="#52b788" stroke-width="2" />
                }

                @* Big azimuth readout in the middle *@
                @((MarkupString)$"<text x='0' y='6' fill='#52b788' font-size='22' font-weight='700' text-anchor='middle'>{Heading(Current?.Azimuth)}°</text>")
            </svg>
        </div>

        <div class="rg-actions">
            <button class="rg-btn" @onclick="GoCcw" disabled="@(!CanTurn)">
                <span class="rg-arr">⏪</span> CCW
            </button>
            @* The controller has one stop, for everything it drives. *@
            <button class="rg-btn rg-go" @onclick="Stop">@(Rotators.Count > 1 ? "STOP ALL" : "STOP")</button>
            <button class="rg-btn" @onclick="GoCw" disabled="@(!CanTurn)">
                CW <span class="rg-arr">⏩</span>
            </button>
        </div>

        <div class="rg-presets">
            @foreach (var (label, az) in Presets)
            {
                <button class="rg-preset" @onclick="() => OnSelectTarget(az)" disabled="@(!CanTurn)">@label</button>
            }
        </div>
    </div>
}

<style>
    .rg-shell {
        background: #0d1727;
        border-radius: 6px;
        overflow: hidden;
        max-width: 560px;
        margin: 0 auto;
        box-shadow: 0 2px 12px rgba(0,0,0,0.4);
    }
    .rg-header {
        display: flex;
        background: #14233b;
        padding: 6px 14px;
        border-bottom: 1px solid #233b5a;
        font-size: 13px;
        color: #a8c8e0;
    }
    .rg-header { gap: 6px; }
    .rg-tab {
        background: none;
        border: 1px solid transparent;
        border-radius: 4px;
        color: inherit;
        font: inherit;
        padding: 4px 10px;
    }
    button.rg-tab { cursor: pointer; }
    button.rg-tab:hover { border-color: #52b788; color: #fff; }
    .rg-tab-on { background: #1f3a3a; border-color: #52b788; color: #fff; }
    .rg-tab strong { color: #52b788; margin-left: 6px; font-size: 16px; }
    .rg-btn:disabled, .rg-preset:disabled { opacity: 0.4; cursor: not-allowed; }
    .rg-canvas {
        background: #0d1727;
        padding: 12px;
        display: flex;
        justify-content: center;
    }
    .rg-canvas svg { width: 100%; max-width: 380px; touch-action: none; }
    .rg-actions {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1px;
        padding: 0 12px 12px;
    }
    .rg-btn {
        padding: 14px 0;
        background: #1c2c46;
        color: #cfe1f0;
        border: 1px solid #2c4670;
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        cursor: pointer;
        border-radius: 4px;
    }
    .rg-btn:hover { background: #1f3a3a; border-color: #52b788; color: #fff; }
    .rg-btn.rg-go { background: #52b788; color: #0d1727; border-color: #52b788; font-weight: 800; }
    .rg-btn.rg-go:hover { background: #6dc99a; border-color: #6dc99a; }
    .rg-arr { font-size: 12px; }
    .rg-presets {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 4px;
        padding: 0 12px 12px;
    }
    .rg-preset {
        padding: 8px 0;
        background: #14233b;
        color: #a8c8e0;
        border: 1px solid #233b5a;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
    }
    .rg-preset:hover { background: #1f3a3a; border-color: #52b788; color: #fff; }
    .dev-empty { padding: 16px; text-align: center; color: #888; }
</style>

@code {
    private DeviceIdentity? Device;
    private IReadOnlyList<RotatorReading> Rotators = [];
    private int Selected;
    private int Azimuth;
    private int? TargetAz;
    private static readonly (string Label, int Azimuth)[] Presets =
    {
        ("N", 0), ("NE", 45), ("E", 90), ("SE", 135),
        ("S", 180), ("SW", 225), ("W", 270), ("NW", 315),
    };

    protected override void OnInitialized()
    {
        Device = Store.KnownDevices.FirstOrDefault(d => d.Kind == DeviceKind.Rotator);
        Refresh();
        Store.Updated += OnUpdated;
    }

    public void Dispose() => Store.Updated -= OnUpdated;

    private void OnUpdated(object? s, DeviceStatusFrame f)
    {
        if (Device is not null && f.DeviceId == Device.Id) Refresh(f);
    }

    private void Refresh(DeviceStatusFrame? frame = null)
    {
        frame ??= Device is null ? null : Store.Get(Device.Id);
        if (frame?.Payload.TryGetValue("rotators", out var raw) == true && raw is System.Collections.IEnumerable rotators)
        {
            Rotators = RotatorReadings.From(rotators);
            if (Rotators.All(r => r.Index != Selected)) Selected = Rotators.FirstOrDefault()?.Index ?? 0;
            Show();
        }
        InvokeAsync(StateHasChanged);
    }

    private RotatorReading? Current => Rotators.FirstOrDefault(r => r.Index == Selected);

    /// <summary>Until a status arrives the first rotator is assumed, as it always was.</summary>
    private bool CanTurn => Device is not null && (Current is null || Current.HasHeading);

    private static string Heading(int? azimuth) => azimuth?.ToString("000") ?? "---";

    /// <summary>Put the selected rotator on the dial. A slot with no heading draws at north, with no target.</summary>
    private void Show()
    {
        Azimuth = Current?.Azimuth ?? 0;
        TargetAz = Current?.Target;
    }

    private void Select(int index)
    {
        Selected = index;
        Show();
    }

    /// <summary>The arguments that send a command to the selected rotator, and no other.</summary>
    private Dictionary<string, object?> Addressed() => new() { ["rotator"] = Selected };

    private async Task OnDialClick(MouseEventArgs e)
    {
        var x = e.OffsetX - 110;
        var y = e.OffsetY - 110;
        var deg = (int)((Math.Atan2(y, x) * 180.0 / Math.PI) + 90 + 360) % 360;
        await OnSelectTarget(deg);
    }

    private async Task OnSelectTarget(int azimuth)
    {
        if (!CanTurn) return;
        TargetAz = azimuth;
        if (Device is not null)
        {
            await Store.ExecuteAsync(new DeviceCommand(
                Device.Id, "rotateTo",
                new Dictionary<string, object?>(Addressed()) { ["azimuth"] = azimuth }));
        }
    }

    private Task GoCw() => !CanTurn
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device!.Id, "cw", Addressed()));

    private Task GoCcw() => !CanTurn
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device!.Id, "ccw", Addressed()));

    private Task Stop() => Device is null
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device.Id, "stop"));
}
