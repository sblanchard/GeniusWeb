@* A/B slot row matching the desktop look: badge | PTT | band | source | freq | OPR. *@

<div class="slot @(Tx ? "tx" : "")">
    <div class="slot-tag">@Label</div>
    <div class="slot-ptt">PTT</div>
    <div class="slot-band">@(string.IsNullOrEmpty(Band) || Band == "Band_None" ? "N/A" : NormalizeBand(Band))</div>
    <div class="slot-source">@Source</div>
    <div class="slot-freq">@FormatFreq(Freq)</div>
    <div class="slot-opr @(Operate ? "on" : "")">OPR</div>
</div>

<style>
    .slot {
        display: grid;
        grid-template-columns: 36px 56px 56px 1fr auto 56px;
        align-items: stretch;
        gap: 1px;
        background: #2a2a2a;
        margin-top: 1px;
        font-size: 13px;
    }
    .slot.tx { background: #8b1f1f; }
    .slot > * { display: flex; align-items: center; padding: 6px 10px; }
    .slot-tag {
        background: #fff;
        color: #000;
        font-weight: 700;
        font-size: 18px;
        justify-content: center;
    }
    .slot.tx .slot-tag { background: #d4d4d4; }
    .slot-ptt {
        background: #2f2f2f;
        color: #aaa;
        font-weight: 600;
        font-size: 12px;
        justify-content: center;
        border-radius: 3px;
    }
    .slot-band {
        background: #2a6e2a;
        color: #fff;
        font-weight: 700;
        justify-content: center;
        border-radius: 3px;
    }
    .slot.tx .slot-band { background: #1f4a1f; }
    .slot-source { color: #ddd; font-weight: 500; }
    .slot.tx .slot-source { color: #fff; }
    .slot-freq {
        font-family: ui-monospace, monospace;
        color: #ffd24f;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .slot.tx .slot-freq { color: #fff; }
    .slot-opr {
        color: #888;
        font-weight: 700;
        font-size: 12px;
        justify-content: center;
    }
    .slot-opr.on { color: #2eea4a; }
</style>

@code {
    [Parameter] public string Label { get; set; } = "A";
    [Parameter] public bool Ptt { get; set; }
    [Parameter] public string Band { get; set; } = "—";
    [Parameter] public double Freq { get; set; }
    [Parameter] public string Source { get; set; } = "";
    [Parameter] public bool Operate { get; set; }
    [Parameter] public bool Tx { get; set; }

    private static string NormalizeBand(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "N/A";
        // "Band_20m" → "20", "20m" → "20"
        var s = raw.Replace("Band_", "");
        return s.EndsWith("m", StringComparison.Ordinal) ? s[..^1] : s;
    }

    private static string FormatFreq(double mhz)
    {
        if (mhz <= 0) return "";
        // 14.236000 → "14.236.000" — group fractional digits with a dot in the middle.
        var raw = mhz.ToString("F6");
        var dot = raw.IndexOf('.');
        if (dot < 0 || raw.Length - dot < 7) return raw;
        return raw[..(dot + 4)] + "." + raw[(dot + 4)..];
    }
}
