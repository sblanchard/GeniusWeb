@page "/settings"
@attribute [Authorize]
@inject GeniusOnline.Web.Services.RuntimeConfigStore Store
@inject NavigationManager Nav

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Settings</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Devices</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
        Set <code>Address</code> to a real IP, or <code>auto</code> to UDP-discover on the LAN.
        Untick <em>Enabled</em> to skip a device without removing it.
    </MudText>

    @if (Devices is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        @foreach (var d in Devices)
        {
            <div class="dev-row">
                <MudCheckBox @bind-Value="d.Enabled" Class="dev-enabled" />
                <MudTextField @bind-Value="d.DisplayName" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="dev-name" />
                <MudSelect T="DeviceKind" Value="d.Kind" ValueChanged="@(k => OnKindChanged(d, k))"
                           Label="Kind" Variant="Variant.Outlined" Margin="Margin.Dense" Class="dev-kind">
                    <MudSelectItem Value="@DeviceKind.Rotator">Rotator</MudSelectItem>
                    <MudSelectItem Value="@DeviceKind.Antenna">Antenna</MudSelectItem>
                    <MudSelectItem Value="@DeviceKind.Power">Power</MudSelectItem>
                    <MudSelectItem Value="@DeviceKind.Tuner">Tuner</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="d.Address" Label="Address (or 'auto')" Variant="Variant.Outlined" Margin="Margin.Dense" Class="dev-addr" />
                <MudNumericField @bind-Value="d.Port" Label="@($"Port (default {DefaultPort(d.Kind)})")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="dev-port" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => Devices!.Remove(d)" />
            </div>
        }

        <MudButton OnClick="AddDevice" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Class="mt-2">
            Add device
        </MudButton>

        <MudButton OnClick="SaveDevices" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3 ms-2">
            Save & reconnect
        </MudButton>

        @if (!string.IsNullOrEmpty(DevicesMessage))
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">@DevicesMessage</MudAlert>
        }
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-3">Password</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
        Stored as a salted PBKDF2-SHA256 hash in the local SQLite database.
    </MudText>
    <MudTextField @bind-Value="NewPassword" InputType="InputType.Password" Label="New password" Variant="Variant.Outlined" />
    <MudTextField @bind-Value="ConfirmPassword" InputType="InputType.Password" Label="Confirm" Variant="Variant.Outlined" Class="mt-2" />

    <MudButton OnClick="SavePassword" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3"
               Disabled="@(string.IsNullOrEmpty(NewPassword))">
        Update password
    </MudButton>

    @if (!string.IsNullOrEmpty(PasswordError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@PasswordError</MudAlert>
    }
    @if (!string.IsNullOrEmpty(PasswordMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mt-3">@PasswordMessage</MudAlert>
    }
</MudPaper>

<style>
    .dev-row {
        display: grid;
        grid-template-columns: auto 1fr 1fr 1.5fr 100px auto;
        gap: 8px;
        align-items: center;
        margin-bottom: 8px;
    }

    @@media (max-width: 800px) {
        .dev-row { grid-template-columns: 1fr; }
    }
</style>

@code {
    private List<DeviceRow>? Devices;
    private string? DevicesMessage;

    private string NewPassword { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private string? PasswordError;
    private string? PasswordMessage;

    public sealed class DeviceRow
    {
        public string Id { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public DeviceKind Kind { get; set; }
        public string? Address { get; set; }
        public int? Port { get; set; }
        public bool Enabled { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        var saved = await Store.GetDevicesAsync();
        Devices = saved.Select(d => new DeviceRow
        {
            Id = d.Id,
            DisplayName = d.DisplayName,
            Kind = d.Kind,
            Address = d.Address,
            Port = d.Port ?? DefaultPort(d.Kind),
            Enabled = true,
        }).ToList();
    }

    private void AddDevice()
    {
        var kind = DeviceKind.Rotator;
        Devices?.Add(new DeviceRow
        {
            Id = $"dev-{Guid.NewGuid().ToString("N")[..8]}",
            DisplayName = "New Device",
            Kind = kind,
            Address = "auto",
            Port = DefaultPort(kind),
        });
    }

    private static int DefaultPort(DeviceKind kind) => kind switch
    {
        DeviceKind.Rotator => 9006,
        DeviceKind.Antenna => 9007,
        DeviceKind.Power   => 9007,
        DeviceKind.Tuner   => 9009,
        _ => 0,
    };

    private static void OnKindChanged(DeviceRow row, DeviceKind newKind)
    {
        var prevDefault = DefaultPort(row.Kind);
        row.Kind = newKind;
        if (row.Port is null || row.Port == prevDefault)
            row.Port = DefaultPort(newKind);
    }

    private async Task SaveDevices()
    {
        if (Devices is null) return;
        DevicesMessage = null;

        var configs = Devices
            .Where(d => d.Enabled)
            .Select(d => new GeniusOnline.Devices.DeviceConfig
            {
                Id = d.Id,
                DisplayName = d.DisplayName,
                Kind = d.Kind,
                Address = string.IsNullOrWhiteSpace(d.Address) ? null : d.Address.Trim(),
                Port = d.Port,
            }).ToList();

        await Store.SaveDevicesAsync(configs);
        DevicesMessage = $"Saved. Reconnecting {configs.Count} device(s)…";
    }

    private async Task SavePassword()
    {
        PasswordError = null;
        PasswordMessage = null;

        if (string.IsNullOrEmpty(NewPassword))
        {
            PasswordError = "Enter a new password.";
            return;
        }
        if (NewPassword != ConfirmPassword)
        {
            PasswordError = "Passwords do not match.";
            return;
        }
        if (NewPassword.Length < 8)
        {
            PasswordError = "Password must be at least 8 characters.";
            return;
        }

        var hash = GeniusOnline.Web.Auth.PasswordHasher.Hash(NewPassword);
        await Store.SavePasswordHashAsync(hash);

        NewPassword = "";
        ConfirmPassword = "";
        PasswordMessage = "Password updated. Existing sessions stay valid; future logins use the new password.";
    }
}
