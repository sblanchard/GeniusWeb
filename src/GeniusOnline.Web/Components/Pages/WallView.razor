@page "/console"
@attribute [Authorize]
@layout EmptyLayout

<PageTitle>GeniusOnline</PageTitle>

<div class="console-shell">
    <header class="console-bar">
        <div class="brand">GeniusOnline · Console</div>
        <nav class="console-nav">
            <a href="/">Mobile</a>
            <a href="/logout">Sign out</a>
        </nav>
    </header>

    <div class="console-grid">
        <div class="console-cell">
            <div class="cell-title">Tuner Genius</div>
            <Tuner />
        </div>
        <div class="console-cell">
            <div class="cell-title">Power Genius</div>
            <Power />
        </div>
        <div class="console-cell">
            <div class="cell-title">Rotator Genius</div>
            <Rotator />
        </div>
        <div class="console-cell">
            <div class="cell-title">Antenna Genius</div>
            <Antenna />
        </div>
    </div>
</div>

<style>
    body { background: #0a0a0a; }

    .console-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #0a0a0a;
        color: #e6e6e6;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .console-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        background: #1a1a1a;
        border-bottom: 1px solid #2a2a2a;
        font-size: 13px;
    }
    .brand { font-weight: 700; letter-spacing: 0.5px; color: #4ea8de; }
    .console-nav { display: flex; gap: 16px; }
    .console-nav a { color: #aaa; text-decoration: none; font-weight: 500; }
    .console-nav a:hover { color: #fff; }

    .console-grid {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 12px;
        padding: 12px;
    }

    @@media (min-width: 1100px) {
        .console-grid {
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
        }
    }

    .console-cell {
        background: #111;
        border: 1px solid #222;
        border-radius: 8px;
        padding: 8px;
        min-width: 0;
    }
    .cell-title {
        font-size: 12px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 4px 8px 8px;
    }

    /* Embedded device pages: drop their max-width and centring so they fill the cell. */
    .console-cell .dev-shell,
    .console-cell .rg-shell,
    .console-cell .ag-shell {
        max-width: none;
        margin: 0;
    }
</style>
