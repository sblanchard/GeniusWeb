@page "/power"
@attribute [Authorize]
@inject GeniusOnline.Web.Services.DeviceLiveStore Store
@implements IDisposable

<PageTitle>Power</PageTitle>

@if (Device is null)
{
    <div class="dev-empty">No PowerGenius configured.</div>
}
else
{
    <div class="dev-shell">
        <div class="dev-section">
            <BarMeter Label="PWR" Value="@Forward" Max="2000" Palette="power"
                      Ticks="@(new []{"0","500","1K","1K5","2K"})" />
            <BarMeter Label="SWR" Value="@Swr" Min="1" Max="3" Format="F2" Palette="swr"
                      Ticks="@(new []{"1.0","1.5","2.0","2.5","3.0"})" />
            <BarMeter Label="Id"  Value="@Current" Max="70" Palette="current"
                      Ticks="@(new []{"0","10","20","30","40","50","60","70"})" />
        </div>

        <div class="pgxl-row">
            <div class="pgxl-slots">
                <SlotRow Label="A" Ptt="@PttA" Band="@BandA" Freq="@FreqA" Source="@(FlexA ?? "FLEX")"
                         Operate="@Operate" Tx="@PttA" />
                <SlotRow Label="B" Ptt="@PttB" Band="@BandB" Freq="@FreqB" Source="@(FlexB ?? "CAT")"
                         Operate="@Operate" Tx="@PttB" />
            </div>
            <div class="pgxl-stats">
                <div><span class="big">@TempA.ToString("F1")</span> / <span class="big">@TempB.ToString("F1")</span> <span class="unit">°C</span></div>
                <div class="stat-row"><span class="lbl">Vdd</span> <span class="big">@Vdd.ToString("F1")</span> <span class="unit">V</span></div>
                <div class="stat-row"><span class="lbl">Vac</span> <span class="big">@Vac.ToString("F0")</span> <span class="unit">V</span></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Fault))
        {
            <div class="pgxl-fault">
                <span>FAULT: @Fault</span>
                <button type="button" class="dev-btn" @onclick="ClearFault">Clear</button>
            </div>
        }

        <div class="dev-footer">
            <span>S/N: @(string.IsNullOrEmpty(Serial) ? "—" : Serial)</span>
            <span>FW: @(string.IsNullOrEmpty(Firmware) ? "—" : Firmware)</span>
            <span>IP: @(Device.Address ?? "—")</span>
            <button type="button" class="dev-btn primary @(Operate ? "active" : "")" @onclick="ToggleOperate">OPERATE</button>
        </div>
    </div>
}

<style>
    .dev-shell {
        background: #1a1a1a;
        border-radius: 6px;
        overflow: hidden;
        max-width: 720px;
        margin: 0 auto;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
    .dev-section { padding: 12px 16px; }
    .pgxl-row {
        display: grid;
        grid-template-columns: 1fr 220px;
        gap: 12px;
        padding: 8px 16px;
        background: #1a1a1a;
    }
    .pgxl-slots { display: flex; flex-direction: column; }
    .pgxl-stats {
        background: #1f1f1f;
        padding: 10px 14px;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
        color: #ddd;
    }
    .pgxl-stats .big { font-size: 18px; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
    .pgxl-stats .lbl { color: #888; width: 32px; display: inline-block; }
    .pgxl-stats .unit { color: #888; font-size: 12px; }
    .stat-row { display: flex; align-items: baseline; gap: 6px; }
    .pgxl-fault {
        display: flex; align-items: center; justify-content: space-between;
        background: #5a1d1d; color: #ffd2d2;
        padding: 8px 16px; font-weight: 600;
    }
    .dev-footer {
        display: flex; gap: 16px; align-items: center;
        padding: 8px 16px; background: #111;
        font-size: 12px; color: #888;
        border-top: 1px solid #333;
    }
    .dev-btn {
        padding: 8px 18px;
        background: transparent;
        border: 1px solid #444;
        color: #999;
        font-weight: 700;
        cursor: pointer;
        border-radius: 4px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .dev-btn:hover { color: #fff; border-color: #4ea8de; }
    .dev-btn.primary.active { color: #ffd24f; border-color: #ffd24f; }
    .dev-footer .dev-btn { margin-left: auto; }
    .dev-empty { padding: 16px; text-align: center; color: #888; }
</style>

@code {
    private DeviceIdentity? Device;
    private DeviceStatusFrame? Frame;
    private double Forward, Swr, Current, Vdd, Vac, TempA, TempB;
    private bool Operate, PttA, PttB;
    private string BandA = "—", BandB = "—";
    private double FreqA, FreqB;
    private string? FlexA, FlexB, Fault, Serial, Firmware;

    protected override void OnInitialized()
    {
        Device = Store.KnownDevices.FirstOrDefault(d => d.Kind == DeviceKind.Power);
        Refresh();
        Store.Updated += OnUpdated;
    }

    public void Dispose() => Store.Updated -= OnUpdated;

    private void OnUpdated(object? s, DeviceStatusFrame f)
    {
        if (Device is not null && f.DeviceId == Device.Id) Refresh(f);
    }

    private void Refresh(DeviceStatusFrame? frame = null)
    {
        Frame = frame ?? (Device is null ? null : Store.Get(Device.Id));
        if (Frame is null) { InvokeAsync(StateHasChanged); return; }
        var p = Frame.Payload;

        Forward = AsD(p, "forwardW");
        Swr = AsD(p, "swr");
        Current = AsD(p, "current");
        Vdd = AsD(p, "voltage");
        Vac = AsD(p, "voltageAC");
        TempA = AsD(p, "tempC");
        TempB = AsD(p, "harmonicTempC");
        if (TempB == 0) TempB = TempA;
        Operate = AsB(p, "operate");
        PttA = AsB(p, "pttA");
        PttB = AsB(p, "pttB");
        BandA = AsS(p, "bandA");
        BandB = AsS(p, "bandB");
        FreqA = AsD(p, "freqA");
        FreqB = AsD(p, "freqB");
        FlexA = AsS(p, "flexA");
        FlexB = AsS(p, "flexB");
        Fault = AsNullableS(p, "fault");
        Serial = AsNullableS(p, "serial");
        Firmware = AsNullableS(p, "firmware");

        InvokeAsync(StateHasChanged);
    }

    private static double AsD(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) && v is not null ? Convert.ToDouble(v) : 0;
    private static bool AsB(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) && v is not null && Convert.ToBoolean(v);
    private static string AsS(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) ? v?.ToString() ?? "" : "";
    private static string? AsNullableS(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) ? v as string : null;

    private Task ToggleOperate() => Device is null
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device.Id, "setOperate",
            new Dictionary<string, object?> { ["on"] = !Operate }));

    private Task ClearFault() => Device is null
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device.Id, "clearFault"));
}
