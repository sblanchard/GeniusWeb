@page "/tuner"
@attribute [Authorize]
@inject GeniusOnline.Web.Services.DeviceLiveStore Store
@implements IDisposable

<PageTitle>Tuner</PageTitle>

@if (Device is null)
{
    <div class="dev-empty">No TunerGenius configured.</div>
}
else
{
    <div class="dev-shell">
        <div class="dev-title">@Device.DisplayName</div>

        <div class="dev-section">
            <BarMeter Label="PWR" Value="@Forward" Max="200" Palette="power"
                      Ticks="@(new []{"0","50","100","175","200"})" />
            <BarMeter Label="SWR" Value="@Swr" Min="1" Max="3" Format="F2" Palette="swr"
                      Ticks="@(new []{"1.0","1.5","2.0","2.5","3.0"})" />
        </div>

        <SlotRow Label="A" Ptt="@PttA" Band="@BandA" Freq="@FreqA" Source="@(FlexA ?? "")"
                 Operate="@Operate" Tx="@PttA" />
        <SlotRow Label="B" Ptt="@PttB" Band="@BandB" Freq="@FreqB" Source="@(FlexB ?? "RF SENSE")"
                 Operate="@Operate" Tx="@PttB" />

        <div class="knob-row">
            <Knob Label="C1" Value="@Cv1" />
            <Knob Label="L"  Value="@Lv" />
            <Knob Label="C2" Value="@Cv2" />

            <div class="action-col">
                <button type="button" class="dev-btn @(!Operate ? "active" : "")" @onclick="ToggleOperate">
                    @(Operate ? "STBY" : "OPR")
                </button>
                <button type="button" class="dev-btn @(Bypass ? "active" : "")" @onclick="DoBypass">BYP</button>
                <button type="button" class="dev-btn primary @(Tuning ? "active" : "")" @onclick="DoTune">TUNE</button>
            </div>
        </div>

        <div class="dev-footer">
            <span>FW: @(Frame?.Connection.ToString() ?? "—")</span>
            <span>IP: @(Device.Address ?? "—")</span>
            <span class="dev-tag">TGXL</span>
        </div>
    </div>
}

<style>
    .dev-shell {
        background: #1a1a1a;
        border-radius: 6px;
        padding: 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        overflow: hidden;
        max-width: 720px;
        margin: 0 auto;
    }
    .dev-title {
        text-align: center;
        font-size: 16px;
        padding: 8px;
        background: #2a2a2a;
        font-weight: 600;
        color: #ddd;
        border-bottom: 1px solid #333;
    }
    .dev-section { padding: 12px 16px; background: #1a1a1a; }
    .knob-row {
        display: grid;
        grid-template-columns: repeat(3, 70px) 1fr;
        gap: 8px;
        padding: 12px 16px;
        background: #1f1f1f;
        align-items: center;
    }
    .action-col { display: flex; gap: 4px; justify-self: end; }
    .dev-btn {
        padding: 18px 14px;
        background: transparent;
        border: 1px solid #444;
        color: #999;
        font-weight: 600;
        cursor: pointer;
        border-radius: 4px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        min-width: 64px;
    }
    .dev-btn:hover { border-color: #4ea8de; color: #fff; }
    .dev-btn.active { color: #d4a017; border-color: #d4a017; }
    .dev-btn.primary.active { color: #ffd24f; border-color: #ffd24f; }
    .dev-footer {
        display: flex;
        gap: 16px;
        padding: 6px 12px;
        background: #111;
        font-size: 12px;
        color: #888;
        border-top: 1px solid #333;
    }
    .dev-tag { margin-left: auto; color: #aaa; font-weight: 600; }
    .dev-empty { padding: 16px; text-align: center; color: #888; }
</style>

@code {
    private DeviceIdentity? Device;
    private DeviceStatusFrame? Frame;
    private double Forward, Swr;
    private double Cv1, Lv, Cv2;
    private bool Operate, Tuning, Bypass;
    private bool PttA, PttB;
    private string BandA = "—", BandB = "—";
    private double FreqA, FreqB;
    private string? FlexA, FlexB;

    protected override void OnInitialized()
    {
        Device = Store.KnownDevices.FirstOrDefault(d => d.Kind == DeviceKind.Tuner);
        Refresh();
        Store.Updated += OnUpdated;
    }

    public void Dispose() => Store.Updated -= OnUpdated;

    private void OnUpdated(object? s, DeviceStatusFrame f)
    {
        if (Device is not null && f.DeviceId == Device.Id) Refresh(f);
    }

    private void Refresh(DeviceStatusFrame? frame = null)
    {
        Frame = frame ?? (Device is null ? null : Store.Get(Device.Id));
        if (Frame is null) { InvokeAsync(StateHasChanged); return; }
        var p = Frame.Payload;

        Forward = AsD(p, "forwardW");
        Swr = AsD(p, "swrIn");
        Lv = AsD(p, "l");
        Cv1 = AsD(p, "c1");
        Cv2 = AsD(p, "c2");
        Operate = AsB(p, "operate");
        Tuning = AsB(p, "tuning");
        Bypass = AsB(p, "bypass");
        PttA = AsB(p, "pttA");
        PttB = AsB(p, "pttB");
        BandA = AsS(p, "bandA");
        BandB = AsS(p, "bandB");
        FreqA = AsD(p, "freqA");
        FreqB = AsD(p, "freqB");
        FlexA = AsS(p, "flexA");
        FlexB = AsS(p, "flexB");

        InvokeAsync(StateHasChanged);
    }

    private static double AsD(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) && v is not null ? Convert.ToDouble(v) : 0;
    private static bool AsB(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) && v is not null && Convert.ToBoolean(v);
    private static string AsS(IReadOnlyDictionary<string, object?> p, string k)
        => p.TryGetValue(k, out var v) ? v?.ToString() ?? "" : "";

    private Task DoTune() => Device is null
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device.Id, "tune"));
    private Task DoBypass() => Device is null
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device.Id, "bypass",
            new Dictionary<string, object?> { ["on"] = !Bypass }));
    private Task ToggleOperate() => Device is null
        ? Task.CompletedTask
        : Store.ExecuteAsync(new DeviceCommand(Device.Id, "operate",
            new Dictionary<string, object?> { ["on"] = !Operate }));
}
