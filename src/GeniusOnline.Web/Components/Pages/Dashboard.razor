@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject GeniusOnline.Web.Services.DeviceLiveStore Store
@implements IDisposable

<PageTitle>Dashboard — GeniusOnline</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Devices</MudText>

@if (!Store.KnownDevices.Any())
{
    <MudAlert Severity="Severity.Info">
        No devices configured. Add entries under <code>Devices.Devices</code> in <code>appsettings.json</code>.
    </MudAlert>
}
else
{
    <MudGrid Spacing="2">
        @foreach (var dev in Store.KnownDevices)
        {
            var frame = Store.Get(dev.Id);
            <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4" Elevation="2">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.subtitle1">@dev.DisplayName</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@StateColor(frame?.Connection)">
                            @(frame?.Connection.ToString() ?? "Unknown")
                        </MudChip>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @dev.Kind · @(dev.Address ?? "(no address)")
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               Href="@($"/{dev.Kind.ToString().ToLowerInvariant()}")" Class="mt-2">
                        Open
                    </MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    protected override void OnInitialized() => Store.Updated += OnUpdated;
    public void Dispose() => Store.Updated -= OnUpdated;
    private void OnUpdated(object? s, DeviceStatusFrame _) => InvokeAsync(StateHasChanged);

    private MudBlazor.Color StateColor(DeviceConnectionState? state) => state switch
    {
        DeviceConnectionState.Connected => MudBlazor.Color.Success,
        DeviceConnectionState.Connecting or DeviceConnectionState.Discovering => MudBlazor.Color.Warning,
        DeviceConnectionState.Faulted => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default,
    };
}
